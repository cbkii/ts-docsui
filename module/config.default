# TS18 Full File Picker runtime settings
# Runtime copy: /data/adb/ts18-documentsui-saf.conf
# Change a value, save the file, then reboot.
# Use 1 for enabled and 0 for disabled unless a comment lists other values.

# Android user that owns the head-unit apps. TS18 normally uses user 0.
TARGET_USER=0

# Maximum number of checks while waiting for Android to finish starting.
BOOT_WAIT_ATTEMPTS=45

# Seconds between Android start checks.
BOOT_WAIT_SECONDS=2

# Keep the Android 10 system file picker enabled.
FIX_ENABLE_AOSP_DOCUMENTSUI=1

# Enable the picker activities needed by apps that choose files or folders.
FIX_ENABLE_DOCUMENTSUI_COMPONENTS=1

# Disable the second Google picker package if it exists, to avoid two competing pickers.
FIX_DISABLE_GOOGLE_DOCUMENTSUI=1

# Disable App Manager's intent interceptor so it cannot replace or wrap the system picker.
FIX_DISABLE_APP_MANAGER_PICKER_INTERCEPTOR=1

# Enable Android's normal shared-storage provider for internal storage and USB drives.
FIX_ENABLE_EXTERNAL_STORAGE_PROVIDER=1

# Disable the test provider bundled inside some Android External Storage APKs.
FIX_DISABLE_EXTERNAL_STORAGE_TEST_PROVIDER=1

# Choose how Android's normal internal-storage root is shown.
# auto = show it only when both the root and its file listing pass a live test.
# show = always show it. hide = hide advanced internal and USB roots.
EXTERNAL_ROOT_MODE=auto

# Enable the bundled provider that adds Internal storage (full) and Root file system.
FIX_ENABLE_ROOT_FILE_PROVIDER=1

# Automatically allow the bundled provider to use Magisk root without a prompt.
FIX_AUTO_GRANT_ROOT_PROVIDER=1

# Show /storage/emulated/0 through the bundled root provider as a reliable fallback.
ROOT_PROVIDER_SHOW_INTERNAL=1

# Show the complete / filesystem through the bundled root provider.
ROOT_PROVIDER_SHOW_DEVICE=1

# Show /storage/usbdisk0 and /storage/usbdisk1 when those paths exist.
ROOT_PROVIDER_SHOW_USB=1

# Allow new files and folders to be created through the root provider.
ROOT_PROVIDER_ALLOW_CREATE=1

# Allow file contents to be changed through the root provider.
ROOT_PROVIDER_ALLOW_WRITE=1

# Allow files and folders to be renamed or moved through the root provider.
ROOT_PROVIDER_ALLOW_RENAME=1

# Allow files and folders to be deleted through the root provider.
# The provider still refuses to delete top-level system anchor folders themselves.
ROOT_PROVIDER_ALLOW_DELETE=1

# Shared-storage folder used briefly while a root file is opened for seekable editing.
# Closed files are removed immediately; stale files are cleaned during boot.
ROOT_PROVIDER_STAGE_DIR=/storage/emulated/0/.TS18-Root-Provider

# Largest root file, in bytes, that may be copied into the shared staging folder.
# Larger read-only files use a stream. Large root-file writes are rejected.
ROOT_PROVIDER_STAGE_LIMIT_BYTES=268435456

# Enable MiXplorer's DocumentsProvider only when MiXplorer is already installed.
FIX_ENABLE_MIXPLORER_PROVIDER=0

# Grant old Android storage permissions to MiXplorer when its provider is enabled.
FIX_GRANT_MIXPLORER_STORAGE_PERMS=0

# Grant Android 10 storage permissions and app-operations to the picker/provider packages.
FIX_GRANT_STORAGE_ACCESS=1

# Create common internal-storage folders when they do not already exist.
FIX_CREATE_STANDARD_INTERNAL_DIRS=1

# Clear the DocumentsUI root cache once after this module version or important config changes.
FIX_REFRESH_PICKER_ON_CHANGE=1

# Run small provider queries after setup so roots are ready before first use.
FIX_WARM_UP_PROVIDERS=1

# Run diagnostics automatically during boot. Keep disabled for normal use.
DIAG_AUTO_RUN_ON_BOOT=0

# Folder used for final diagnostic archives and logs.
DIAG_OUTPUT_ROOT=/storage/emulated/0/Download/TS18-SAF-Diagnostics

# Include APKs directly related to the picker and storage providers in diagnostics.
DIAG_COPY_RELEVANT_APKS=1

# Include every installed APK. This can produce a very large archive.
DIAG_COPY_ALL_APKS=0

# Largest single file copied into diagnostics, in bytes.
DIAG_MAX_COPY_BYTES=52428800
