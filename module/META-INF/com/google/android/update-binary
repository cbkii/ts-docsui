#!/system/bin/sh
# Thin Magisk loader. Real install logic is in customize.sh.
OUTFD=$2
ZIPFILE=$3
ui_print() { echo -e "ui_print $1
ui_print" >> /proc/self/fd/$OUTFD; }
require_new_magisk() { ui_print "Magisk module installer is unavailable or too old"; exit 1; }
[ -f /data/adb/magisk/util_functions.sh ] || require_new_magisk
. /data/adb/magisk/util_functions.sh
install_module
exit 0
